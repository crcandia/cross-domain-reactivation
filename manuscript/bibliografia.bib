@article{Nora1989,
abstract = {Nora's notion of a site of memory, or lieu de m{\'{e}}moire, is anything concrete or conceptual that has become a symbolic element of memorial heritage in a community as the result of human will or historical process. This includes archives, museums, cemeteries, rituals, commemorations, texts, inherited property, and special days. Sites of memory are ``where [cultural] memory crystallizes and secretes itself'' (7). For Nora, sites of memory are modern phenomena, and not present in all cultures. They replace a `real' and `true' living memory; a constructed history replaces true memory. Sites of memory are artificial and fabricated, existing simply to help us recall the past, which is necessary in order to make living in the modern world meaningful. Their purpose is to ``stop time, to block the work of forgetting'' by way of a ``will to remember'' (19). This, however, excludes prehistoric sites, as their primary characteristic is ``often precisely what ought to exclude them from being lieux de m{\'{e}}moire: the absolute absence of a will to remember and , by way of compensation, the crushing weight imposed on them by time, science, and the dreams of men'' (20). },
author = {Nora, Pierre},
journal = {Representations},
keywords = {Memory, Monuments, History, Forgetting},
mendeley-groups = {Collective Memory,Altruistic Punishment},
pages = {7--25},
title = {{Between Memory and History: Les Lieux de M{\'e}moire}},
volume = {26},
year = {1989}
}
